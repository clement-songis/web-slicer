{
	"name": "frontend",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"printers:covers": "node scripts/copy-printer-covers.mjs",
		"dev": "node scripts/copy-printer-covers.mjs && node scripts/copy-calib-models.mjs && vite dev",
		"build": "node scripts/copy-printer-covers.mjs && node scripts/copy-calib-models.mjs && vite build",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.158",
		"@inlang/paraglide-js": "^3.2.2",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.73.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"fflate": "^0.8.3",
		"three": "^0.187.0"
	}
}
