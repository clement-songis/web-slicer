{
	"extends": "$app/tsconfig",
	"include": ["src/**/*"],
	"exclude": ["src/service-worker", "build", "scripts", "server.js"],
	"compilerOptions": {
		"types": ["bun", "unplugin-icons/types/svelte", "$app/types"],
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		},
		"sourceMap": true,
		"strict": true
	}
}
